# Brewfile — run with:  brew bundle --file=Brewfile

# ── CLI ──────────────────────────────────────────────────────────────────────
brew "git"
brew "zsh"
brew "gh"          # GitHub CLI
brew "antidote"    # zsh plugin manager
brew "oh-my-posh"  # prompt
brew "mise"        # runtime manager (node, global npm tools)
brew "zoxide"      # smarter cd
brew "dockutil"    # manage Dock items from the CLI
brew "doctl"       # DigitalOcean CLI

# ── Apps + font ──────────────────────────────────────────────────────────────
cask "ghostty"                        # terminal app
cask "rectangle"                      # window manager
cask "bitwarden"                      # password manager
cask "firefox"                        # browser
cask "zen"                            # browser
cask "visual-studio-code"             # code editor
cask "pearcleaner"                    # app uninstaller / leftover cleaner
cask "keepingyouawake"                # menu-bar toggle to keep the Mac awake
cask "discord"                        # communications app
cask "obsidian"                       # markdown editor and organiser
cask "proton-mail"                    # Proton Mail + Calendar client
cask "docker-desktop"                 # containers (bundles Linux VM, engine, CLI, compose)
cask "affinity"                       # design / photo / layout suite (v3)
cask "spotify"                        # music streaming

cask "font-jetbrains-mono-nerd-font"  # nerd font for terminal
