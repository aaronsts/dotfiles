<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.rnsts.filemover</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SCRIPT__</string>
  </array>

  <!-- Auto-start on login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Restart automatically if it ever crashes -->
  <key>KeepAlive</key>
  <true/>

  <!-- Log output -->
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchd.log</string>

  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchd-error.log</string>

</dict>
</plist>
