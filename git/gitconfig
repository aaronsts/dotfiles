[user]
	name = Aaron
	# GitHub noreply address, so this public repo doesn't expose a personal email
	email = 70277183+aaronsts@users.noreply.github.com

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[alias]
	undo = reset HEAD~1 --mixed

# Machine-specific overrides (e.g. a work email per directory); not tracked here.
# Kept last so it wins. Git skips it if the file doesn't exist.
[include]
	path = ~/.config/git/local
