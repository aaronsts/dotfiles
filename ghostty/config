# ~/.config/ghostty/config  (symlinked from dotfiles/ghostty/config)

font-family = "JetBrainsMono Nerd Font"
font-size = 16

# Using Ghostty's default theme for now.
# Browse options with `ghostty +list-themes`, then set e.g.  theme = "catppuccin-mocha"

window-padding-x = 16
window-padding-y = 16
window-padding-balance = true
macos-titlebar-style = transparent
mouse-hide-while-typing = true

keybind = cmd+shift+r=reload_config
